# ===== Fluent180 server configuration (the ONLY place AI settings live) =====
# Copy to .env for local development, or add these in Vercel → Project → Settings → Environment Variables.
# Never commit a real .env file.

# Which AI provider: anthropic | openai | gemini
AI_PROVIDER=anthropic

# Secret key for that provider (server-side only; never sent to the browser)
AI_API_KEY=

# Optional model overrides. Defaults exist for anthropic; openai and gemini require AI_MODEL.
AI_MODEL=
AI_MODEL_FAST=

# Optional: only allow requests from your site (comma-separated), e.g. https://fluent180.vercel.app
ALLOWED_ORIGINS=

# Speech and text-to-speech currently use the learner's browser (no key needed).
# Reserved for a future server-side speech service:
# SPEECH_PROVIDER=
# SPEECH_API_KEY=
# TTS_PROVIDER=
# TTS_API_KEY=
